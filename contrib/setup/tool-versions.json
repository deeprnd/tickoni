        "version_ref": "just",
        "asset_pattern": "just-{version}-{arch}-unknown-linux-gnu.tar.gz",
        "asset_pattern_os_map": {
          "darwin": {
            "arm64": "just-{version}-aarch64-apple-darwin.tar.gz",
            "x86_64": "just-{version}-x86_64-apple-darwin.tar.gz"
          },
          "windows": "just-{version}-{arch}-pc-windows-msvc.zip"
