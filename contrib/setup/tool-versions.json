      "parameters": {
        "packages": [
          "clang-18",
          "llvm-18"
        ],
        "version_key": "clang"
      },
      "idempotent_check": "command -v clang",
      "_note": "Linux apt: clang-18 + llvm-18 are same toolchain version"
    },
    "llvm": {
      "category": "toolchain",
      "platform": "macos",
      "install_method": "brew",
      "parameters": {
        "package": "llvm"
      },
      "idempotent_check": "test -x \"$(brew --prefix llvm 2>/dev/null)/bin/llvm-ar\""
    },
    "msvc": {
      "category": "mvsc",
      "platform": "windows",
      "install_method": "winget",
      "parameters": {
        "package": "Microsoft.VisualStudio.2022.BuildTools",
        "override": "--add Microsoft.VisualStudio.Workload.VCTools --includeRecommended --quiet --wait --norestart"
      },
      "idempotent_check": "command -v cl"
    },
    "make": {
      "category": "build",
      "platform": "all",
      "install_method": {
        "linux": "apt",
        "macos": "brew",
        "windows": "winget"
      },
      "parameters": {
        "package": "make",
        "winget_id": "GnuWin32.Make"
      },
      "idempotent_check": "command -v mingw32-make >/dev/null 2>&1 || { gmake --version 2>/dev/null || make --version 2>/dev/null; } | grep -qE 'GNU Make ([4-9]|[0-9][0-9])'",
      "_note": "Firedancer's makefiles need GNU Make >= 4.0 ($(file ...) builtin). macOS ships /usr/bin/make 3.81, so a plain 'command -v make' would wrongly pass and the FD build would silently drop fd_version.o / libfd_util.a."
    },
    "cmake": {
      "category": "build",
      "platform": "all",
      "install_method": {
        "linux": "apt",
        "macos": "brew",
