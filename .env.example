# Qt Online Installer credentials
# Used by setup-qt-* recipes for unattended installation
#
# Local: copy this file to .env and fill in your credentials
# CI: set QT_USERNAME and QT_TOKEN as repository secrets
#
# Get credentials from: https://account.qt.io/
# → Settings → API Tokens → Generate API Token
# Use the token as QT_TOKEN

QT_USERNAME=
QT_TOKEN=
